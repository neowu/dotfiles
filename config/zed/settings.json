{
  "disable_ai": true,
  "edit_predictions": {
    "provider": "none",
  },
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "theme": "Nord",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "use_system_window_tabs": true,
  "use_system_path_prompts": true,
  "inlay_hints": {
    "enabled": true,
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.7,
  },
  "cursor_blink": true,
  "preferred_line_length": 120,
  "wrap_guides": [120],
  "excerpt_context_lines": 5,
  "expand_excerpt_lines": 5,
  "terminal": {
    "copy_on_select": true,
    "detect_venv": "off",
    "option_as_meta": true,
    "cursor_shape": "bar",
    "keep_selection_on_copy": true,
    "blinking": "on",
    "line_height": "comfortable",
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "minimap": {
    "show": "always",
    "thumb_border": "none",
    "display_in": "active_editor",
  },
  "project_panel": {
    "dock": "left",
    "diagnostic_badges": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "show_user_menu": false,
    "show_sign_in": false,
    "show_branch_status_icon": true,
  },
  "diff_view_style": "split",
  "git": {
    "blame": {
      "show_avatar": false,
    },
    "inline_blame": {
      "location": "status_bar",
    },
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "error",
    },
  },
  "languages": {
    "JSON": {
      "preferred_line_length": 120,
    },
    "Markdown": {
      "preferred_line_length": 300,
    },
  },
  "document_symbols": "on",
  "completion_menu_item_kind": "symbol",
  "semantic_tokens": "combined",
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "rustfmt": {
          "extraArgs": ["+nightly"],
        },
        "check": {
          "command": "clippy",
        },
        "cargo": {
          "features": "all",
        },
      },
    },
  },
  "global_lsp_settings": {
    "semantic_token_rules": [
      {
        "token_type": "enumMember",
        "style": ["type"],
      },
      {
        "token_type": "namespace",
        "style": ["variable"],
      },
    ],
  },
  "markdown_preview": {
    "max_width": 1200.0,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
}
